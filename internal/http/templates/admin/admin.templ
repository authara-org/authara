package admin

import (
	appfeatures "github.com/authara-org/authara/internal/features"
	"github.com/authara-org/authara/internal/http/templates"
	"github.com/authara-org/authara/internal/http/templates/components/workspace"
)

type FeatureFlags = appfeatures.Features

templ AdminShell(active string, features FeatureFlags) {
	{{
		tabs := []workspace.Tab{
			{Href: "/auth/admin", Label: "Dashboard", Active: active == "dashboard"},
			{Href: "/auth/admin/users", Label: "Users", Active: active == "users"},
		}
		if features.AllowlistEnabled {
			tabs = append(tabs, workspace.Tab{Href: "/auth/admin/allowlist", Label: "Allowlist", Active: active == "allowlist"})
		}
		tabs = append(tabs,
			workspace.Tab{Href: "/auth/admin/failures", Label: "Failures", Active: active == "failures"},
			workspace.Tab{Href: "/auth/admin/audit", Label: "Audit log", Active: active == "audit"},
		)
	}}
	@templates.PartialRender() {
		@workspace.Shell(workspace.Config{
			Title:       "Admin",
			Description: "Manage users, access controls, and authentication operations.",
			TabsLabel:   "Admin sections",
			Tabs:        tabs,
			ContentID:   "admin-content",
			AccountHref: "/auth/account?return_to=/auth/admin",
			ViewportHeight: active == "audit",
		}) {
			{ children... }
		}
	}
}
