package user

import (
	"github.com/authara-org/authara/internal/http/templates"
	"github.com/authara-org/authara/internal/http/templates/auth"
	"github.com/authara-org/authara/internal/http/templates/components/icons"
	"github.com/authara-org/authara/internal/http/viewmodel"
	"github.com/google/uuid"
)

type AccountConfig struct {
	Username         string
	Email            string
	OperatorAccess   bool
	GoogleClientID   string
	Sessions         []viewmodel.Session
	CurrentSessionID uuid.UUID
	AuthProviders    []viewmodel.AuthProvider
	Passkeys         []viewmodel.Passkey
	SessionsCursor   string
	SessionsNext     string
	PasskeysCursor   string
	PasskeysNext     string
}

templ Account(cfg AccountConfig) {
	@templates.PartialRender() {
		<div
			x-data="{ deleteOpen: false }"
			class="min-h-screen bg-background-light dark:bg-background-dark"
		>
			<div class="mx-auto max-w-2xl px-4 sm:px-6 py-4 sm:py-14">
				<div class="rounded-2xl max-w-2xl border border-grey-200 dark:border-grey-800 bg-white dark:bg-grey-900 overflow-hidden">
					<div class="border-b border-grey-100 dark:border-grey-800">
						<div>
							<div class="p-6 sm:p-8 border-b border-grey-200 dark:border-grey-800">
								@auth.CardHeader()
								@AccountProfileHeader(cfg.Username, cfg.Email)
							</div>
							@CollapsibleSection(true) {
								@AccountPersonalInfo(cfg.Username, cfg.Email)
							}
							@CollapsibleSection(true) {
								@SessionSection(cfg.Sessions, cfg.CurrentSessionID)
								if cfg.SessionsNext != "" {
									@AccountCollectionNext("More sessions", accountPageHref(cfg.SessionsNext, cfg.PasskeysCursor))
								}
							}
							@CollapsibleSection(false) {
								@LinkedProvidersSection(cfg.AuthProviders, cfg.Passkeys, cfg.GoogleClientID)
								if cfg.PasskeysNext != "" {
									@AccountCollectionNext("More passkeys", accountPageHref(cfg.SessionsCursor, cfg.PasskeysNext))
								}
							}
						</div>
					</div>
					@AccountFooterActions(cfg.OperatorAccess)
				</div>
				@AccountDangerZone()
			</div>
			@DeleteAccountConfirmForm()
			@RemovePasswordConfirmForm()
			@RemoveGoogleConfirmForm()
			@RemoveAppleConfirmForm()
			@AccountPasswordDialog()
		</div>
	}
}

templ AccountCollectionNext(label string, href string) {
	<div class="mt-4 flex justify-end">
		<a class="text-sm font-medium text-primary-600 hover:text-primary-700 dark:text-primary-400" href={ templ.SafeURL(href) }>{ label }</a>
	</div>
}

templ CollapsibleSection(bordered bool) {
	<div
		x-data="{ open: false }"
		:class="open ? 'h-auto sm:h-auto' : 'h-16 sm:h-22'"
		class={ sectionClass(bordered) + " overflow-hidden h-16 sm:h-22" }
	>
		<button
			type="button"
			aria-label="Toggle section"
			:aria-expanded="open.toString()"
			@click="open = !open"
			class="absolute inset-x-0 top-0 z-10 h-16 cursor-pointer rounded-none transition-colors hover:bg-grey-50/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-600 dark:hover:bg-grey-800/40 sm:h-22"
		>
			<span
				:class="open ? 'rotate-180' : ''"
				class="absolute right-4 top-5 block h-6 w-6 text-grey-600 transition-transform duration-300 ease-in-out stroke-2 dark:text-grey-400 sm:right-8 sm:top-8"
			>
				@icons.ChevronDown()
			</span>
		</button>
		{ children... }
	</div>
}

func sectionClass(bordered bool) string {
	base := "relative p-4 sm:p-8"
	if bordered {
		return base + " border-b border-grey-200 dark:border-grey-800"
	}
	return base
}
