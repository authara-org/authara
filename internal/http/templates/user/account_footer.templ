package user

import (
	"github.com/authara-org/authara/internal/http/kit/httpctx"
	"github.com/authara-org/authara/internal/http/kit/redirect"
	"github.com/authara-org/authara/internal/http/templates/components/button"
	"github.com/authara-org/authara/internal/http/templates/components/icons"
)

templ AccountFooterActions(operatorAccess bool) {
	<div class="p-4 sm:p-6 bg-grey-50 dark:bg-grey-950 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
		if operatorAccess {
			@button.LinkButton(button.LinkButtonConfig{
				Href:    "/auth/operator",
				Label:   "Operator workspace",
				Variant: button.Outline,
				Color:   button.Main,
			})
		}
		<form
			hx-post={ templ.SafeURL(redirect.WithReturnTo("/auth/sessions/logout", httpctx.ReturnToOrDefault(ctx))) }
			class="w-full sm:ml-auto sm:w-auto"
		>
			@CSRFInput()
			@button.Button(button.ButtonConfig{
				Label:   "Log out",
				Icon:    icons.Logout(),
				Variant: button.Outline,
				Color:   button.Attention,
			})
		</form>
	</div>
}
