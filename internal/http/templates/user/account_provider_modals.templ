package user

import "github.com/authara-org/authara/internal/http/templates/components/csrf"

templ AccountPasswordDialog() {
	<dialog
		id="account-password-dialog"
		aria-label="Manage password"
		class="native-modal m-auto w-[min(100%-2rem,30rem)] overflow-hidden rounded-2xl border border-grey-200 bg-white p-0 shadow-2xl dark:border-grey-800 dark:bg-grey-900"
	>
		<div class="relative">
			<button
				type="button"
				aria-label="Close"
				data-account-password-dialog-close
				class="absolute right-4 top-4 z-10 flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg text-grey-500 hover:bg-grey-100 hover:text-grey-800 dark:text-grey-400 dark:hover:bg-grey-800 dark:hover:text-grey-100"
			>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-5 w-5" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18 18 6M6 6l12 12"></path>
				</svg>
			</button>
			<div id="account-password-dialog-content"></div>
		</div>
	</dialog>
}

templ RemovePasswordConfirmForm() {
	<form
		id="remove-password-form"
		hx-post="/auth/providers/password/unlink"
		hx-target="#linked-providers-section"
		hx-swap="outerHTML"
		class="hidden"
	>
		@csrf.CSRFInput()
	</form>
}

templ RemoveGoogleConfirmForm() {
	<form
		id="remove-google-form"
		hx-post="/auth/providers/google/unlink"
		hx-target="#linked-providers-section"
		hx-swap="outerHTML"
		class="hidden"
	>
		@csrf.CSRFInput()
	</form>
}

templ RemoveAppleConfirmForm() {
	<form
		id="remove-apple-form"
		hx-post="/auth/providers/apple/unlink"
		hx-target="#linked-providers-section"
		hx-swap="outerHTML"
		class="hidden"
	>
		@csrf.CSRFInput()
	</form>
}
