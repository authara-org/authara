package operator

import (
	"strconv"

	"github.com/authara-org/authara/internal/domain"
	"github.com/authara-org/authara/internal/email"
	"github.com/authara-org/authara/internal/http/templates/components/button"
	"github.com/authara-org/authara/internal/http/templates/components/csrf"
	"github.com/authara-org/authara/internal/http/templates/components/datatable"
	"github.com/authara-org/authara/internal/http/templates/components/dropdown"
	"github.com/authara-org/authara/internal/http/templates/components/icons"
	"github.com/authara-org/authara/internal/http/templates/components/theme"
	"github.com/authara-org/authara/internal/http/templates/components/workspace"
)

templ EmailTemplates(templates []email.EffectiveTemplate) {
	@Shell("emails") {
		<div class="flex h-full min-h-0 flex-1 flex-col gap-5 overflow-hidden">
			<div class="flex shrink-0 flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<p class="text-xs font-medium uppercase tracking-[0.16em] text-grey-500 dark:text-grey-400">Email</p>
					<h2 class="mt-1 text-2xl font-semibold tracking-tight">Template catalog</h2>
					<p class="mt-2 max-w-2xl text-sm text-grey-600 dark:text-grey-400">Customize the subject, plain-text body, and HTML body of every Core-owned transactional email.</p>
				</div>
				<span class="inline-flex w-fit rounded-full bg-green-50 px-2.5 py-1 text-xs font-medium text-green-800 dark:bg-green-900/30 dark:text-green-200">Live editor</span>
			</div>
			@datatable.Table(datatable.Config{
				Columns: []datatable.Column{
					{Label: "Email template"},
					{Label: "Status", WidthClass: "w-44"},
					{Label: "Delivery", WidthClass: "w-24"},
					{Label: "Action", WidthClass: "w-44"},
				},
				MinWidthClass:    "min-w-[48rem]",
				RowCount:         len(templates),
				RowLabel:         "template",
				EmptyTitle:       "No email templates",
				EmptyDescription: "Core-owned transactional email templates will appear here.",
			}) {
				for _, template := range templates {
					<tr>
						<td class="px-4 py-3 align-middle">
							<p class="font-medium text-grey-900 dark:text-grey-100">{ template.Definition.DisplayName }</p>
							<p class="mt-1 leading-6 text-grey-600 dark:text-grey-400">{ template.Definition.Description }</p>
						</td>
						<td class="px-4 py-3 align-middle">
							if template.Source == email.TemplateSourceOverride {
								<span class="inline-flex rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-800 dark:bg-green-900/30 dark:text-green-200">Customized</span>
							} else {
								<span class="inline-flex rounded-full bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-800 dark:bg-blue-900/30 dark:text-blue-200">Built-in default</span>
							}
						</td>
						<td class="px-4 py-3 align-middle">
							@EmailTemplateDeliveryToggle(template.Definition.Key, !template.DeliveryDisabled)
						</td>
						<td class="px-4 py-3 align-middle">
							@workspace.TextLink(emailTemplateHref(template.Definition.Key), "Edit and preview")
						</td>
					</tr>
				}
			}
		</div>
	}
}

templ EmailTemplateDeliveryToggle(key domain.EmailTemplate, enabled bool) {
	<form
		method="post"
		action={ emailTemplateDeliveryHref(key) }
		hx-post={ emailTemplateDeliveryHref(key) }
		hx-target="this"
		hx-swap="outerHTML"
	>
		@csrf.CSRFInput()
		<input
			type="hidden"
			name="enabled"
			value={ strconv.FormatBool(!enabled) }
		/>
		<button
			type="submit"
			role="switch"
			aria-checked={ strconv.FormatBool(enabled) }
			aria-label={ emailTemplateDeliveryLabel(key) }
			class={
				"relative inline-flex h-7 w-12 cursor-pointer items-center rounded-full border p-0.5 shadow-inner hover:shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-grey-900",
				templ.KV("border-blue-600 bg-blue-600 dark:border-blue-500 dark:bg-blue-600", enabled),
				templ.KV("border-grey-300 bg-grey-100 dark:border-grey-600 dark:bg-grey-700", !enabled),
			}
		>
			<span
				aria-hidden="true"
				class={
					"pointer-events-none block h-5 w-5 rounded-full bg-white shadow-sm ring-1 ring-black/5",
					templ.KV("translate-x-5", enabled),
				}
			></span>
		</button>
	</form>
}

templ EmailTemplateEditor(model EmailTemplateEditorModel) {
	@EditorShell() {
		<div id="email-template-workspace" class="flex h-full min-h-0 flex-col" data-email-template-workspace x-data="{ mode: 'html', dirty: false }" @input="dirty = true" @email-template-persisted.window="dirty = false" @email-template-diagnostic.window="if ($event.detail.part === 'text' || $event.detail.part === 'html') mode = $event.detail.part">
			<header class="flex min-h-16 shrink-0 flex-wrap items-center gap-3 border-b border-grey-200 bg-white px-4 py-2 dark:border-grey-800 dark:bg-grey-900">
				<a class="inline-flex h-10 items-center gap-1.5 rounded-lg px-3 text-sm font-medium text-grey-600 hover:bg-grey-100 hover:text-grey-900 dark:text-grey-300 dark:hover:bg-grey-800 dark:hover:text-white" href="/auth/operator/emails" @click="if (dirty && !window.confirm('Discard unsaved changes?')) $event.preventDefault()">
					<span class="h-5 w-5 shrink-0 stroke-[1.5]" aria-hidden="true">
						@icons.ArrowLeft()
					</span>
					Templates
				</a>
				<div class="min-w-52 flex-1 sm:max-w-xs">
					<label class="sr-only" for="email-template-selector">Email template</label>
					@dropdown.Dropdown(dropdown.Config{
						ID:           "email-template-selector",
						Value:        emailTemplateHref(model.Definition.Key),
						Options:      emailTemplateDropdownOptions(),
						Class:        "w-full",
						TriggerClass: "font-medium",
						OnChange:     "if (dirty && !window.confirm('Discard unsaved changes?')) { $event.preventDefault() } else { window.location.href = $event.detail.value }",
					})
				</div>
				@emailTemplateSourceStatus(model, false)
				@emailTemplateHistory(model, false)
				<div class="flex rounded-lg bg-grey-100 p-1 text-sm dark:bg-grey-800" aria-label="Email body format" role="group">
					<button class="rounded-md px-3 py-1.5 font-medium" type="button" :aria-pressed="mode === 'text'" :class="mode === 'text' ? 'bg-white text-grey-900 shadow-sm dark:bg-grey-700 dark:text-white' : 'text-grey-500 dark:text-grey-300'" @click="mode = 'text'">Text</button>
					<button class="rounded-md px-3 py-1.5 font-medium" type="button" :aria-pressed="mode === 'html'" :class="mode === 'html' ? 'bg-white text-grey-900 shadow-sm dark:bg-grey-700 dark:text-white' : 'text-grey-500 dark:text-grey-300'" @click="mode = 'html'">HTML</button>
				</div>
				<div id="email-template-actions" class="ml-auto flex items-center gap-2">
					<span class="hidden text-xs font-medium text-green-700 dark:text-green-300 sm:inline" data-email-template-preview-status role="status">Preview ready</span>
					<span id="email-template-preview-indicator" class="htmx-indicator inline-flex h-4 w-4 animate-spin rounded-full border-2 border-blue-200 border-t-blue-600 dark:border-blue-900 dark:border-t-blue-300" aria-hidden="true"></span>
					@button.Button(button.ButtonConfig{
						Label:   "Render",
						Type:    button.RegularButton,
						Size:    button.Small,
						Color:   button.Light,
						Variant: button.Outline,
						Class:   " !h-10 !w-auto !rounded-lg",
						Attrs: templ.Attributes{
							"data-email-template-preview-request": "",
							"data-email-template-action":          "",
							"hx-post":                             previewEmailTemplateHref(model.Definition.Key),
							"hx-include":                          "#email-template-form",
							"hx-target":                           "#email-template-preview",
							"hx-select":                           "#email-template-preview",
							"hx-select-oob":                       "#email-template-feedback:outerHTML",
							"hx-swap":                             "outerHTML",
							"hx-sync":                             "#email-template-form:abort",
							"hx-indicator":                        "this",
						},
					})
					@emailTemplateRestoreAction(model, false)
					@emailTemplateSaveAction(model, false)
					@theme.ThemeToggle()
				</div>
			</header>
			<div class="grid min-h-0 flex-1 grid-cols-1 overflow-y-auto lg:grid-cols-[minmax(0,1.7fr)_minmax(24rem,0.8fr)] lg:overflow-hidden">
				@emailTemplateForm(model, false)
				@emailTemplatePreview(model, false)
			</div>
		</div>
	}
}

templ EmailTemplateSaveSuccess(model EmailTemplateEditorModel) {
	@EmailTemplateFeedback(model)
	@emailTemplateSourceStatus(model, true)
	@emailTemplateHistory(model, true)
	@emailTemplateRevision(model.Revision, true)
	@emailTemplateRestoreAction(model, true)
	@emailTemplateSaveAction(model, true)
	@emailTemplatePreview(model, true)
}

templ EmailTemplateRestoreSuccess(model EmailTemplateEditorModel) {
	@EmailTemplateFeedbackOOB(model)
	@emailTemplateSourceStatus(model, true)
	@emailTemplateHistory(model, true)
	@emailTemplateRestoreAction(model, true)
	@emailTemplateSaveAction(model, true)
	@emailTemplateForm(model, true)
	@emailTemplatePreview(model, true)
}

templ emailTemplateSourceStatus(model EmailTemplateEditorModel, oob bool) {
	<div
		id="email-template-source-status"
		class="hidden sm:block"
		if oob {
			hx-swap-oob="outerHTML"
		}
	>
		if model.ViewingVersion > 0 {
			<span class="inline-flex rounded-full bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-800 dark:bg-amber-900/30 dark:text-amber-200" data-email-template-viewing-version>Viewing v{ strconv.FormatInt(model.ViewingVersion, 10) }</span>
		} else if model.Source == email.TemplateSourceOverride {
			if model.ActiveVersion > 0 {
				<span class="inline-flex rounded-full bg-green-50 px-2.5 py-1 text-xs font-medium text-green-800 dark:bg-green-900/30 dark:text-green-200">Customized · v{ strconv.FormatInt(model.ActiveVersion, 10) }</span>
			} else {
				<span class="inline-flex rounded-full bg-green-50 px-2.5 py-1 text-xs font-medium text-green-800 dark:bg-green-900/30 dark:text-green-200">Customized</span>
			}
		} else {
			<span class="inline-flex rounded-full bg-blue-50 px-2.5 py-1 text-xs font-medium text-blue-800 dark:bg-blue-900/30 dark:text-blue-200">Built-in</span>
		}
	</div>
}

templ emailTemplateHistory(model EmailTemplateEditorModel, oob bool) {
	<div
		id="email-template-history"
		class="w-44"
		if oob {
			hx-swap-oob="outerHTML"
		}
	>
		@dropdown.Dropdown(dropdown.Config{
			ID:           "email-template-history-dropdown",
			Value:        emailTemplateHistoryDropdownValue(model),
			Options:      emailTemplateHistoryDropdownOptions(model),
			Class:        "w-full",
			TriggerClass: "font-medium",
			TriggerLabel: "History (" + strconv.Itoa(len(model.Versions)) + ")",
			OnChange:     "if (!$event.detail.value) { return } if (dirty && !window.confirm('Discard your draft and open this version?')) { $event.preventDefault() } else { window.location.href = $event.detail.value }",
			Attrs: templ.Attributes{
				"@email-template-persisted.window": "close(false)",
			},
		})
	</div>
}

templ emailTemplateSaveAction(model EmailTemplateEditorModel, oob bool) {
	<div
		id="email-template-save-action"
		class="contents"
		if oob {
			hx-swap-oob="outerHTML"
		}
	>
		if model.ViewingVersion > 0 {
			<a
				class="inline-flex h-10 items-center rounded-lg px-3 text-sm font-medium text-grey-600 hover:bg-grey-100 hover:text-grey-900 dark:text-grey-300 dark:hover:bg-grey-800 dark:hover:text-white"
				href={ emailTemplateHref(model.Definition.Key) }
				@click="if (dirty && !window.confirm('Discard your draft and return to the current template?')) $event.preventDefault()"
			>Return to current</a>
		}
		@button.Button(button.ButtonConfig{
			Label: saveEmailTemplateLabel(model),
			Type:  button.RegularButton,
			Size:  button.Small,
			Class: " !h-10 !w-auto !rounded-lg px-4",
			Attrs: templ.Attributes{
				"form":                             "email-template-form",
				"data-email-template-action":       "",
				"data-email-template-save-request": "",
				"hx-post":                          emailTemplateHref(model.Definition.Key),
				"hx-include":                       "#email-template-form",
				"hx-target":                        "#email-template-feedback",
				"hx-swap":                          "outerHTML",
				"hx-sync":                          "#email-template-form:drop",
				"hx-indicator":                     "this",
				"hx-disabled-elt":                  "#email-template-actions [data-email-template-action]:not([data-email-template-save-request])",
			},
		})
	</div>
}

templ emailTemplateRestoreAction(model EmailTemplateEditorModel, oob bool) {
	<div
		id="email-template-restore-action"
		class="contents"
		if oob {
			hx-swap-oob="outerHTML"
		}
	>
		if model.Source == email.TemplateSourceOverride && model.ViewingVersion == 0 {
			<form
				method="post"
				action={ resetEmailTemplateHref(model.Definition.Key) }
				hx-post={ resetEmailTemplateHref(model.Definition.Key) }
				hx-target="#email-template-workspace"
				hx-swap="none"
				hx-sync="#email-template-form:drop"
				hx-disabled-elt="#email-template-actions [data-email-template-action]"
				@submit="if (dirty && !window.confirm('Restore the built-in template and discard your draft?')) $event.preventDefault()"
			>
				@csrf.CSRFInput()
				<input type="hidden" name="revision" value={ strconv.FormatInt(model.Revision, 10) }/>
				@button.Button(button.ButtonConfig{
					Label:   "Restore",
					Type:    button.Submit,
					Size:    button.Small,
					Color:   button.Light,
					Variant: button.Outline,
					Class:   " !h-10 !w-auto !rounded-lg",
					Attrs: templ.Attributes{
						"data-email-template-action":          "",
						"data-email-template-restore-request": "",
					},
				})
			</form>
		}
	</div>
}

templ emailTemplateForm(model EmailTemplateEditorModel, oob bool) {
	<form
		id="email-template-form"
		class="flex min-h-[42rem] flex-col bg-white dark:bg-grey-950 lg:min-h-0 lg:border-r lg:border-grey-200 lg:dark:border-grey-800"
		data-email-template-preview-request
		method="post"
		action={ emailTemplateHref(model.Definition.Key) }
		hx-post={ previewEmailTemplateHref(model.Definition.Key) }
		hx-trigger="input delay:500ms"
		hx-target="#email-template-preview"
		hx-select="#email-template-preview"
		hx-select-oob="#email-template-feedback:outerHTML"
		hx-swap="outerHTML"
		hx-sync="this:abort"
		hx-indicator="#email-template-preview-indicator"
		if oob {
			hx-swap-oob="outerHTML"
		}
	>
		@csrf.CSRFInput()
		@emailTemplateRevision(model.Revision, false)
		<div class="shrink-0 space-y-3 border-b border-grey-200 p-4 dark:border-grey-800">
			@EmailTemplateFeedback(model)
			<div>
				<label class="text-xs font-medium uppercase tracking-wide text-grey-500 dark:text-grey-400" for="email-template-subject">Subject</label>
				<input class="mt-1.5 h-10 w-full rounded-lg border border-grey-200 bg-white px-3 text-sm text-grey-900 focus:outline-none focus:ring-2 focus:ring-blue-200 dark:border-grey-700 dark:bg-grey-900 dark:text-grey-100 dark:focus:ring-blue-900/40" id="email-template-subject" name="subject_template" value={ model.SubjectTemplate }/>
			</div>
			<details class="text-xs text-grey-600 dark:text-grey-300">
				<summary class="w-fit cursor-pointer select-none font-medium text-blue-700 dark:text-blue-300">Variables and requirements</summary>
				<div class="mt-2 flex flex-wrap items-center gap-1.5">
					for _, variable := range model.Definition.AvailableVariables {
						<code class="rounded-md bg-grey-100 px-2 py-1 text-grey-700 dark:bg-grey-800 dark:text-grey-200">{ "{{" + variable + "}}" }</code>
					}
					if len(model.Definition.RequiredSubjectVariables) > 0 {
						<span>Subject requires { placeholderList(model.Definition.RequiredSubjectVariables) }.</span>
					}
					if len(model.Definition.RequiredBodyVariables) > 0 {
						<span>Both bodies require { placeholderList(model.Definition.RequiredBodyVariables) }.</span>
					}
				</div>
			</details>
		</div>
		<div class="min-h-0 flex-1 p-4">
			<div class="flex h-full min-h-0 flex-col" x-cloak x-show="mode === 'text'">
				<label class="mb-2 text-xs font-medium uppercase tracking-wide text-grey-500 dark:text-grey-400" for="email-template-text">Plain-text body</label>
				<textarea class="min-h-0 flex-1 rounded-lg border border-grey-200 bg-white p-4 font-mono text-sm leading-6 text-grey-900 focus:outline-none focus:ring-2 focus:ring-blue-200 dark:border-grey-800 dark:bg-grey-900 dark:text-grey-100 dark:focus:ring-blue-900/40" data-email-template-editor="text" data-email-template-editor-fill="true" id="email-template-text" name="text_template">{ model.TextTemplate }</textarea>
			</div>
			<div class="flex h-full min-h-0 flex-col" x-show="mode === 'html'">
				<label class="mb-2 text-xs font-medium uppercase tracking-wide text-grey-500 dark:text-grey-400" for="email-template-html">HTML body</label>
				<textarea class="min-h-0 flex-1 rounded-lg border border-grey-200 bg-white p-4 font-mono text-sm leading-6 text-grey-900 focus:outline-none focus:ring-2 focus:ring-blue-200 dark:border-grey-800 dark:bg-grey-900 dark:text-grey-100 dark:focus:ring-blue-900/40" data-email-template-editor="html" data-email-template-editor-fill="true" id="email-template-html" name="html_template">{ model.HTMLTemplate }</textarea>
			</div>
		</div>
	</form>
}

templ emailTemplateRevision(revision int64, oob bool) {
	<input
		id="email-template-revision"
		type="hidden"
		name="revision"
		value={ strconv.FormatInt(revision, 10) }
		if oob {
			hx-swap-oob="outerHTML"
		}
	/>
}

templ EmailTemplatePreviewResponse(model EmailTemplateEditorModel) {
	@EmailTemplateFeedback(model)
	@emailTemplatePreview(model, false)
}

templ EmailTemplateFeedback(model EmailTemplateEditorModel) {
	@emailTemplateFeedback(model, false)
}

templ EmailTemplateFeedbackOOB(model EmailTemplateEditorModel) {
	@emailTemplateFeedback(model, true)
}

templ emailTemplateFeedback(model EmailTemplateEditorModel, oob bool) {
	<div
		id="email-template-feedback"
		class="empty:hidden"
		if oob {
			hx-swap-oob="outerHTML"
		}
	>
		if model.Error != "" {
			if model.Diagnostic != nil {
				<span
					hidden
					data-email-template-diagnostic
					data-template-part={ string(model.Diagnostic.Part) }
					data-template-line={ strconv.Itoa(model.Diagnostic.Line) }
					data-template-message={ model.Diagnostic.Message }
				></span>
			}
			if model.Diagnostic == nil || model.Diagnostic.Line <= 0 {
				<div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-900 dark:border-red-900 dark:bg-red-950 dark:text-red-100" role="alert">
					<p class="font-semibold">The template could not be processed.</p>
					<p class="mt-1">{ model.Error }</p>
					if model.Conflict {
						<a class="mt-3 inline-flex font-medium underline" href={ emailTemplateHref(model.Definition.Key) }>Reload the current revision</a>
					}
				</div>
			}
		}
	</div>
}

templ emailTemplatePreview(model EmailTemplateEditorModel, oob bool) {
	<section
		id="email-template-preview"
		class="flex min-h-[42rem] flex-col overflow-hidden bg-grey-100 dark:bg-grey-900 lg:min-h-0"
		if oob {
			hx-swap-oob="outerHTML"
		}
	>
		<div class="flex h-11 shrink-0 items-center justify-between border-b border-grey-200 bg-white px-4 dark:border-grey-800 dark:bg-grey-950">
			<div class="flex items-center gap-2">
				<h2 class="text-sm font-semibold">Preview</h2>
				<span class="text-xs text-grey-500 dark:text-grey-400" x-text="mode === 'html' ? 'HTML' : 'Plain text'"></span>
			</div>
			<span class="text-xs text-grey-500 dark:text-grey-400">Sample data</span>
		</div>
		if model.Preview != nil {
			<div class="shrink-0 border-b border-grey-200 bg-white px-4 py-3 text-sm dark:border-grey-800 dark:bg-grey-950">
				<span class="font-medium text-grey-500 dark:text-grey-400">Subject:</span>
				<span class="ml-1">{ model.Preview.Subject }</span>
			</div>
			<div class="min-h-0 flex-1" x-show="mode === 'html'">
				<iframe class="h-full w-full bg-white" sandbox="" srcdoc={ model.Preview.HTML } title="Rendered HTML email preview"></iframe>
			</div>
			<pre class="min-h-0 flex-1 overflow-auto whitespace-pre-wrap bg-white p-6 font-mono text-sm leading-6 text-grey-900 dark:bg-grey-950 dark:text-grey-100" x-cloak x-show="mode === 'text'">{ model.Preview.Text }</pre>
		} else {
			<div class="p-5 text-sm text-red-800 dark:text-red-200" data-email-template-preview-error role="alert">
				<p class="font-medium">Preview unavailable</p>
				if model.Error != "" {
					<p class="mt-1">Auto-render stopped because: { model.Error }</p>
				} else {
					<p class="mt-1">Fix the validation error to refresh the preview.</p>
				}
			</div>
		}
	</section>
}
