package operator

import (
	"fmt"

	"github.com/authara-org/authara/internal/http/templates/components/workspace"
)

templ Dashboard(templateCount int) {
	@Shell("dashboard") {
		<div class="space-y-6">
			<section class="overflow-hidden rounded-xl border border-grey-200 bg-white dark:border-grey-800 dark:bg-grey-900">
				<div class="grid gap-0 lg:grid-cols-[1.4fr_0.6fr]">
					<div class="p-6 sm:p-8">
						<span class="inline-flex rounded-full bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-800 dark:bg-blue-900/30 dark:text-blue-200">Operator workspace ready</span>
						<h2 class="mt-5 max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl">Shape every message your users receive.</h2>
						<p class="mt-3 max-w-2xl text-grey-600 dark:text-grey-300">Edit, validate, and preview the transactional emails owned by this Authara deployment.</p>
						<div class="mt-6">
							@workspace.TextLink("/auth/operator/emails", "Customize email templates")
						</div>
					</div>
					<div class="border-t border-grey-200 bg-grey-50 p-6 dark:border-grey-800 dark:bg-grey-950 lg:border-l lg:border-t-0 sm:p-8">
						<p class="text-sm font-medium text-grey-600 dark:text-grey-400">Built-in templates</p>
						<p class="mt-2 text-5xl font-semibold tracking-tight">{ fmt.Sprint(templateCount) }</p>
						<p class="mt-3 text-sm text-grey-600 dark:text-grey-400">Every template has text and HTML output with a defined set of variables.</p>
					</div>
				</div>
			</section>
			<section aria-labelledby="workspace-roadmap">
				<div class="mb-3 flex items-end justify-between gap-4">
					<div>
						<p class="text-xs font-medium uppercase tracking-[0.16em] text-grey-500 dark:text-grey-400">Workspace</p>
						<h2 id="workspace-roadmap" class="mt-1 text-xl font-semibold">Configuration areas</h2>
					</div>
				</div>
				<div class="overflow-hidden rounded-xl border border-grey-200 bg-white dark:border-grey-800 dark:bg-grey-900">
					<div class="grid gap-0 md:grid-cols-3">
						@workspaceItem("Email templates", "Available", "Edit subject, text, and HTML sources with a safe sample preview.", "/auth/operator/emails", true)
						@workspaceItem("Runtime configuration", "Planned", "Manage reloadable deployment settings without restarting Core.", "", false)
						@workspaceItem("Observability", "Planned", "Choose which operational metrics the deployment retains.", "", false)
					</div>
				</div>
			</section>
		</div>
	}
}

templ workspaceItem(title string, status string, description string, href string, available bool) {
	<div class="border-b border-grey-200 p-5 last:border-b-0 dark:border-grey-800 md:border-b-0 md:border-r md:last:border-r-0">
		<div class="flex items-center justify-between gap-3">
			<h3 class="font-semibold">{ title }</h3>
			<span class={ statusClass(available) }>{ status }</span>
		</div>
		<p class="mt-2 text-sm leading-6 text-grey-600 dark:text-grey-400">{ description }</p>
		if available {
			<div class="mt-4">
				@workspace.TextLink(href, "Open")
			</div>
		}
	</div>
}

func statusClass(available bool) string {
	base := "rounded-full px-2 py-1 text-xs font-medium"
	if available {
		return base + " bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-200"
	}
	return base + " bg-grey-100 text-grey-600 dark:bg-grey-800 dark:text-grey-300"
}
