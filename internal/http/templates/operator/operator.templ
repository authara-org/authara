package operator

import (
	"github.com/authara-org/authara/internal/http/templates"
	"github.com/authara-org/authara/internal/http/templates/components/theme"
)

templ Shell(active string) {
	@templates.PartialRender() {
		<div class="min-h-screen bg-background-light text-grey-900 dark:bg-background-dark dark:text-grey-100">
			<div class="mx-auto min-h-screen max-w-6xl px-4 py-6 sm:px-6 sm:py-12">
				<header class="border-b border-grey-200 pb-5 dark:border-grey-800">
					<div class="flex items-start justify-between gap-4">
						<div>
							<p class="text-xs font-medium uppercase tracking-[0.18em] text-blue-700 dark:text-blue-300">Authara Core</p>
							<h1 class="mt-1 text-3xl font-semibold tracking-tight">Operator</h1>
							<p class="mt-1 max-w-2xl text-sm text-grey-600 dark:text-grey-400">Customize the user-facing behavior of this Authara deployment.</p>
						</div>
						<div class="block sm:hidden">
							@theme.ThemeToggle()
						</div>
					</div>
					<div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
						<nav aria-label="Operator" class="flex flex-wrap gap-2 text-sm">
							@navLink("/auth/operator", "Dashboard", active == "dashboard")
							@navLink("/auth/operator/emails", "Email templates", active == "emails")
							@navLink("/auth/operator/audit", "Audit log", active == "audit")
						</nav>
						<a class="text-sm font-medium text-blue-700 hover:underline dark:text-blue-300" href="/auth/account?return_to=/auth/operator">Back to account</a>
					</div>
				</header>
				<section id="operator-content" class="pt-6">
					{ children... }
				</section>
			</div>
		</div>
	}
}

templ EditorShell() {
	@templates.PartialRender() {
		<div class="fixed inset-0 z-20 flex h-dvh w-screen flex-col overflow-hidden bg-background-light text-grey-900 dark:bg-background-dark dark:text-grey-100">
			{ children... }
		</div>
	}
}

templ navLink(href string, label string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		aria-current={ navAriaCurrent(active) }
		class={ navClass(active) }
	>
		{ label }
	</a>
}
