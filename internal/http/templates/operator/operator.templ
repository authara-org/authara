package operator

import (
	"github.com/authara-org/authara/internal/http/templates"
	"github.com/authara-org/authara/internal/http/templates/components/workspace"
)

templ Shell(active string) {
	@templates.PartialRender() {
		@workspace.Shell(workspace.Config{
			Title:       "Operator",
			Description: "Customize the user-facing behavior of this Authara deployment.",
			TabsLabel:   "Operator sections",
			Tabs: []workspace.Tab{
				{Href: "/auth/operator", Label: "Dashboard", Active: active == "dashboard"},
				{Href: "/auth/operator/emails", Label: "Email templates", Active: active == "emails"},
				{Href: "/auth/operator/settings", Label: "Runtime settings", Active: active == "settings"},
				{Href: "/auth/operator/audit", Label: "Audit log", Active: active == "audit"},
			},
			ContentID:      "operator-content",
			AccountHref:    "/auth/account?return_to=/auth/operator",
			ViewportHeight: active == "audit" || active == "emails",
		}) {
			{ children... }
		}
	}
}

templ EditorShell() {
	@templates.PartialRender() {
		<div class="fixed inset-0 z-20 flex h-dvh w-screen flex-col overflow-hidden bg-background-light text-grey-900 dark:bg-background-dark dark:text-grey-100">
			{ children... }
		</div>
	}
}
