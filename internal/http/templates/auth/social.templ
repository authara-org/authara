package auth

import (
	"context"
	"strings"

	"github.com/authara-org/authara/internal/http/kit/httpctx"
	"github.com/authara-org/authara/internal/http/templates/components/button"
	"github.com/authara-org/authara/internal/http/templates/components/icons"
	"github.com/authara-org/authara/internal/http/viewmodel"
	"github.com/authara-org/authara/internal/oauth"
)

templ OAuthProviders(action string, oauthProviders []oauth.OAuthProvider, appleReturnTo string) {
	if len(oauthProviders) != 0 {
		<div class="relative flex justify-center my-5">
			<p class="bg-white dark:bg-grey-900 text-sm px-4 z-2 text-grey-700 dark:text-grey-300">
				or
			</p>
			<div class="absolute w-full top-1/2 -translate-y-1/2 left-0 h-0.5 bg-grey-200 dark:bg-grey-800 z-1"></div>
		</div>
		<div class="flex flex-col gap-3">
			for _, p := range oauthProviders {
				switch p.Name {
					case "google":
						@GoogleSignin(action, p.ClientID, viewmodel.AuthProviderFlowLogin, "")
					case "apple":
						@AppleSignin(action, viewmodel.AuthProviderFlowLogin, "", "", appleReturnTo)
				}
			}
		</div>
	}
}

templ GoogleSignin(action string, clientID string, flow viewmodel.AuthProviderFlow, linkID string) {
	<script src="https://accounts.google.com/gsi/client" async></script>
	@button.Button(button.ButtonConfig{
		Type:  button.RegularButton,
		Color: button.Custom,
		Class: " relative !h-[42px] !w-full !rounded-xl !border !border-grey-400 !px-3.5 !py-0 text-base text-grey-800 overflow-hidden bg-white hover:bg-grey-50 hover:border-grey-500 dark:!border-transparent dark:bg-white dark:text-grey-800 dark:hover:!border-transparent dark:hover:bg-grey-50",
		Attrs: templ.Attributes{
			"id":               "google-signin-btn",
			"data-provider":    "google",
			"data-google-flow": string(flow),
			"data-link-id":     linkID,
			"data-return-to":   httpctx.ReturnToOrDefault(ctx),
		},
	}) {
		<div
			id="g_id_onload"
			data-client_id={ clientID }
			data-callback="autharaGoogleCallback"
			data-auto_prompt="false"
			data-nonce={ httpctx.OAuthNonceOrDefault(ctx, "") }
		></div>
		<img
			src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
			class="h-4 w-4"
			alt="Google logo"
		/>
		<span>{ googleButtonLabel(action) }</span>
		<div class="absolute inset-0 overflow-hidden opacity-[0.00001%]">
			<div
				class="g_id_signin"
				data-type="standard"
				data-size="large"
				data-theme="outline"
				data-text="sign_in_with"
				data-shape="rectangular"
				data-logo_alignment="left"
				data-width="400"
			></div>
		</div>
	}
}

templ AppleSignin(action string, flow viewmodel.AuthProviderFlow, authenticationChallengeID string, linkID string, returnTo string) {
	<div
		class="authara-apple-signin w-full"
		data-apple-flow={ string(flow) }
		data-return-to={ appleReturnDestination(ctx, returnTo) }
		data-authentication-challenge-id={ authenticationChallengeID }
		data-link-id={ linkID }
	>
		<button
			type="button"
			data-apple-button
			disabled
			aria-disabled="true"
			class="relative h-[42px] w-full cursor-pointer overflow-hidden rounded-xl border-0 bg-black px-3.5 py-0 text-base text-white transition-[background-color,opacity] hover:bg-grey-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 disabled:cursor-wait dark:bg-white dark:text-grey-800 dark:hover:bg-grey-50 dark:focus-visible:ring-offset-grey-900"
		>
			<span class="flex h-full items-center justify-center gap-2">
				<span class="flex h-5 w-5 shrink-0 items-center justify-center" aria-hidden="true">
					@icons.AppleLogoBlack()
				</span>
				<span>{ appleButtonLabel(action) }</span>
			</span>
		</button>
	</div>
}

func appleReturnDestination(ctx context.Context, override string) string {
	if override != "" {
		return override
	}
	return httpctx.ReturnToOrDefault(ctx)
}

func googleButtonLabel(action string) string {
	switch strings.ToLower(strings.TrimSpace(action)) {
	case "login", "signin", "sign in":
		return "Sign in with Google"
	case "create account", "signup", "sign up":
		return "Sign up with Google"
	default:
		return action + " with Google"
	}
}

func appleButtonLabel(action string) string {
	switch strings.ToLower(strings.TrimSpace(action)) {
	case "login", "sign in":
		return "Sign in with Apple"
	case "create account", "sign up", "signup":
		return "Sign up with Apple"
	case "link":
		return "Link Apple"
	default:
		return "Continue with Apple"
	}
}
