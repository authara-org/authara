package auth

import (
	"github.com/authara-org/authara/internal/http/kit/httpctx"
	"github.com/authara-org/authara/internal/http/kit/redirect"
	"github.com/authara-org/authara/internal/http/templates"
	"github.com/authara-org/authara/internal/http/templates/components/button"
	"github.com/authara-org/authara/internal/http/templates/components/csrf"
	"github.com/authara-org/authara/internal/http/templates/components/form"
	"github.com/authara-org/authara/internal/http/templates/components/icons"
)

templ ChangePassword() {
	@templates.PartialRender() {
		@AuthLayout() {
			@CardHeader()
			@HeaderSection("Change Password", "Update your password for this account.")
			@ChangePasswordForm(false)
		}
	}
}

templ ChangePasswordDialog() {
	<div class="px-6 pb-6 pt-7 sm:px-8 sm:pb-8">
		<h2 class="pr-10 text-2xl font-semibold text-grey-900 dark:text-grey-100">Change password</h2>
		<p class="mb-6 mt-1 text-sm leading-relaxed text-grey-600 dark:text-grey-300">
			Update the password you use to sign in to this account.
		</p>
		@ChangePasswordForm(true)
	</div>
}

templ ChangePasswordForm(modal bool) {
	<form
		x-data
		autocomplete="on"
		hx-post={ redirect.WithReturnTo("/auth/providers/password/change", httpctx.ReturnToOrManualDefault(ctx, "/auth/account")) }
		hx-target="#body"
		hx-swap="innerHTML"
	>
		@csrf.CSRFInput()
		if modal {
			<input type="hidden" name="modal" value="1"/>
		}
		@form.Input(form.InputConfig{
			Type:         form.Email,
			Size:         form.Large,
			Name:         "email",
			Value:        httpctx.EmailOrDefault(ctx, ""),
			Autocomplete: "username",
			Class:        "hidden",
			Unstyled:     true,
			Attrs: templ.Attributes{
				"tabindex": "-1",
			},
		})
		<label for="current-password" class="text-grey-800 dark:text-grey-200">
			<div class="pb-1.5">Current Password <span class="text-red-600">*</span></div>
		</label>
		<div x-data="{ show: false }" class="mb-4 relative">
			@form.Input(form.InputConfig{
				ID:           "current-password",
				Type:         form.Password,
				Name:         "current_password",
				Autocomplete: "current-password",
				Placeholder:  "Enter your current password",
				Required:     true,
				Class:        "!pr-12",
				Attrs: templ.Attributes{
					":type":      "show ? 'text' : 'password'",
					"autofocus": modal,
				},
			})
			@passwordToggleButton()
		</div>
		<label for="new-password" class="text-grey-800 dark:text-grey-200">
			<div class="pb-1.5">New Password <span class="text-red-600">*</span></div>
		</label>
		<div x-data="{ show: false }" class="mb-4 relative">
			@form.Input(form.InputConfig{
				ID:           "new-password",
				Type:         form.Password,
				Size:         form.Large,
				Name:         "new_password",
				Autocomplete: "new-password",
				Placeholder:  "Enter your new password",
				Required:     true,
				Class:        "!pr-12",
				Attrs: templ.Attributes{
					":type": "show ? 'text' : 'password'",
				},
			})
			@passwordToggleButton()
		</div>
		<label for="confirm-password" class="text-grey-800 dark:text-grey-200">
			<div class="pb-1.5">Confirm New Password <span class="text-red-600">*</span></div>
		</label>
		<div x-data="{ show: false }" class="mb-4 relative">
			@form.Input(form.InputConfig{
				ID:           "confirm-password",
				Type:         form.Password,
				Size:         form.Large,
				Name:         "confirm_password",
				Autocomplete: "new-password",
				Placeholder:  "Repeat your new password",
				Required:     true,
				Class:        "!pr-12",
				Attrs: templ.Attributes{
					":type": "show ? 'text' : 'password'",
				},
			})
			@passwordToggleButton()
			</div>
			<p class="text-sm text-grey-600 dark:text-grey-400 mb-4">
				Changing your password revokes all other sessions and pending password-reset codes. This session stays signed in. Without a shared revocation cache, another device may remain active until its current access token expires.
			</p>
		@button.Button(button.ButtonConfig{
			Label: "Change Password",
			Icon:  icons.Lock(),
		})
	</form>
}
