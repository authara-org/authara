package auth

import "github.com/authara-org/authara/internal/http/ui"

templ MicrosoftRedirect() {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Microsoft Authentication</title>
		</head>
		<body>
			<p>Completing Microsoft authentication…</p>
			<script src={ ui.Static(ctx, "microsoft-redirect.js") }></script>
		</body>
	</html>
}
