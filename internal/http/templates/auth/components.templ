package auth

import "github.com/authara-org/authara/internal/http/templates/components/card"
import "github.com/authara-org/authara/internal/http/templates/components/button"
import "github.com/authara-org/authara/internal/http/templates/components/theme"
import "github.com/authara-org/authara/internal/http/kit/httpctx"

templ AuthLayout() {
	<div class="flex w-full min-h-screen bg-background-light dark:bg-background-dark">
		<div class="py-3 sm:py-10 px-4 sm:px-6 w-full">
			@card.FullPageCard(card.FullPageCardConfig{Size: card.Small}) {
				<div class="w-full px-8 py-8 sm:px-14 sm:py-10">
					{ children... }
				</div>
			}
		</div>
	</div>
}

templ CardHeader() {
	<div class="flex justify-between mb-5 sm:mb-7">
		@button.Back(httpctx.ReturnToOrDefault(ctx))
		<div class="block sm:hidden">
			@theme.ThemeToggle()
		</div>
	</div>
}

templ HeaderSection(title, description string) {
	{{
		titleMargin := "mb-8"
		if description != "" {
			titleMargin = "mb-2"
		}
	}}
	<h1 class={ "text-3xl text-center text-grey-900 dark:text-grey-100 " + titleMargin }>{ title }</h1>
	if description != "" {
		<h2 class="text-md mb-8 text-center text-grey-700 dark:text-grey-300">{ description }</h2>
	}
}
